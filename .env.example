# OpenAI (or an OpenAI-compatible endpoint) — powers all agent reasoning.
OPENAI_API_KEY=

# Optional: model to use (defaults to gpt-4o-mini if unset).
OPENAI_MODEL=gpt-4o-mini

# Optional: override the API base URL, e.g. for an Azure OpenAI deployment.
OPENAI_BASE_URL=

# Optional: reasoning effort for reasoning-capable models (none|low|medium|high|xhigh).
OPENAI_REASONING_EFFORT=

# Anakin API key — used for live web search and URL scraping. Omitted = mock data fallback.
ANAKIN_API_KEY=

# Placeholder: base URL of the future ops-room backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Placeholder: WebSocket URL of the future ops-room backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
