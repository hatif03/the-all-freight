# Agent reasoning is proxied through the ops-room backend's /llm/complete
# endpoint (see src/lib/openai.ts) — that backend already has clean Vertex AI
# credentials (Application Default Credentials on its VM), so this app needs
# no GCP credentials of its own. Just point it at the backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Anakin API key — used for live web search and URL scraping. Omitted = mock data fallback.
ANAKIN_API_KEY=
