# Gemini (OpenAI-compatible endpoint) — powers all planning-flow agent reasoning.
GEMINI_API_KEY=

# Optional: model to use (defaults to gemini-3.6-flash if unset).
GEMINI_MODEL=gemini-3.6-flash

# Anakin API key — used for live web search and URL scraping. Omitted = mock data fallback.
ANAKIN_API_KEY=

# Placeholder: base URL of the ops-room backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Placeholder: WebSocket URL of the ops-room backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
