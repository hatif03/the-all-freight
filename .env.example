# Vertex AI (Gemini via GCP, OpenAI-compatible endpoint) — powers all planning-flow
# agent reasoning. Authenticated with Application Default Credentials, not an API
# key: run `gcloud auth application-default login` locally (already required to
# have `gcloud` set up), or nothing at all when deployed on GCP (the attached
# service account provides credentials automatically).
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Optional: model to use (defaults to google/gemini-2.5-flash if unset).
GEMINI_MODEL=google/gemini-2.5-flash

# Anakin API key — used for live web search and URL scraping. Omitted = mock data fallback.
ANAKIN_API_KEY=

# Placeholder: base URL of the ops-room backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Placeholder: WebSocket URL of the ops-room backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
