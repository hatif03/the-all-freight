# Infra — local Docker Postgres + Redis by default: `docker compose up -d`
# (see docker-compose.yml). Swap for a hosted URL when deploying.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ops_room
REDIS_URL=redis://localhost:6379

# Publicly reachable HTTPS origin for this service, used to register Anakin
# monitor webhooks (e.g. https://136-119-139-202.nip.io). Leave unset locally:
# Anakin can't call back to a loopback address, so monitors register without a
# webhook and changes are read by polling instead.
PUBLIC_BASE_URL=

# Data
AISSTREAM_API_KEY=

# Models / partners
# Vertex AI (Gemini via GCP, OpenAI-compatible endpoint) — Logistics, Finance,
# Procurement, Customer-Impact. Authenticated with Application Default
# Credentials, not an API key: `gcloud auth application-default login` locally,
# or nothing at all when deployed on GCP.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# K2 Think (MBZUAI/IFM, OpenAI-compatible endpoint) — Carrier, Dissent.
K2THINK_API_KEY=
FEATHERLESS_KEY=

# Anakin — live web layer: search, AI structured extraction from pages
# (tariff fetch, BoL lookup) and scheduled page-change monitors.
ANAKIN_API_KEY=
