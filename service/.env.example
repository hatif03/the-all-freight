# Infra — local Docker Postgres + Redis (see docker-compose.yml). Swap these
# for a hosted DATABASE_URL/REDIS_URL when deploying.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ops_room
REDIS_URL=redis://localhost:6379

# Data
AISSTREAM_API_KEY=

# Models / partners
# Gemini — Logistics, Finance, Procurement, Customer-Impact (see agents/model_router.py)
GEMINI_API_KEY=
# K2 Think — Carrier, Dissent (the two roles that most need strong reasoning)
K2THINK_API_KEY=
FEATHERLESS_KEY=

# Anakin (live web search/scrape + Wire catalog — tariff fetch, BoL live lookup)
ANAKIN_API_KEY=
